# Environment Configuration

# Server
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Database (Default: SQLite; To migrate to PostgreSQL, switch the connection string)
DATABASE_URL=sqlite:///./mining_safety.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/mining_safety_db

# Simulation Settings
SIMULATION_INTERVAL_SECONDS=2.0
ENABLE_SYNTHETIC_GENERATOR=True

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
